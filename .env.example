# Copy to .env for local API development and replace both secrets with random values.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
API_PUBLIC_URL=http://localhost:5000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/nerloq_example
MONGODB_DATABASE=nerloq
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_IDLE_TIMEOUT_MS=2592000000
# Account recovery can use console in development. Production requires Resend or SendGrid.
EMAIL_PROVIDER=console
# EMAIL_FROM=NERLOQ <support@example.com>
# EMAIL_API_KEY=replace-with-provider-api-key
