{
  "name": "nerloq",
  "version": "1.0.0",
  "private": true,
  "description": "NERLOQ — a next-generation social video, messaging, creator, commerce and real-time media platform.",
  "license": "UNLICENSED",
  "author": "NERLOQ",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared",
    "packages/validation",
    "packages/config"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@nerloq/web",
    "dev:api": "npm run dev --workspace=@nerloq/api",
    "build": "npm run build --workspace=@nerloq/shared && npm run build --workspace=@nerloq/validation && npm run build --workspace=@nerloq/config && npm run build --workspace=@nerloq/api && npm run build --workspace=@nerloq/web",
    "build:web": "npm run build --workspace=@nerloq/web",
    "build:api": "npm run build --workspace=@nerloq/api",
    "start": "npm run start --workspace=@nerloq/api",
    "typecheck": "npm run typecheck --workspace=@nerloq/shared && npm run typecheck --workspace=@nerloq/validation && npm run typecheck --workspace=@nerloq/config && npm run typecheck --workspace=@nerloq/api && npm run typecheck --workspace=@nerloq/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fastify": "^5.6.1",
    "hls.js": "^1.6.13",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "mongoose": "^8.19.1",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@types/node": "^24.8.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "overrides": {}
}
